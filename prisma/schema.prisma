generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
}

enum CertificateType {
  TESTIMONIAL
  CHARACTER
  TRANSFER
  CERTIFICATE
}

enum AdmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommitteeRole {
  PRESIDENT
  SECRETARY
  MEMBER
  TEACHER_REP
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  notices   Notice[]
}

model Student {
  id          String        @id @default(cuid())
  studentId   String        @unique
  name        String
  banglaName  String?
  fatherName  String
  motherName  String
  dateOfBirth DateTime
  gender      Gender
  religion    String?
  class       String
  section     String?
  roll        Int?
  session     String
  address     String?
  phone       String?
  photo       String?
  status      StudentStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  results     Result[]
}

model Teacher {
  id          String   @id @default(cuid())
  employeeId  String   @unique
  name        String
  banglaName  String?
  designation String
  subject     String
  qualification String?
  joiningDate DateTime
  phone       String?
  email       String?
  photo       String?
  status      Boolean  @default(true)
  nid         String?
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notice {
  id            String    @id @default(cuid())
  title         String
  content       String    @db.Text
  category      String    @default("General")
  attachmentUrl String?
  isPublished   Boolean   @default(false)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  authorId      String?
  author        User?     @relation(fields: [authorId], references: [id])
}

model Result {
  id            String   @id @default(cuid())
  studentId     String
  examName      String
  subject       String
  fullMarks     Float
  passMarks     Float
  obtainedMarks Float
  grade         String?
  gpa           Float?
  session       String
  class         String
  section       String?
  year          String
  publishedAt   DateTime?
  createdAt     DateTime @default(now())
  student       Student  @relation(fields: [studentId], references: [id])
}

model Certificate {
  id              String          @id @default(cuid())
  certificateNo   String          @unique
  studentId       String
  studentName     String
  fatherName      String
  class           String
  session         String
  issueDate       DateTime
  type            CertificateType
  qrCode          String?         @db.Text
  isVerified      Boolean         @default(false)
  verifiedAt      DateTime?
  createdAt       DateTime        @default(now())
  verificationLogs VerificationLog[]
}

model VerificationLog {
  id            String      @id @default(cuid())
  certificateId String
  verifierIp    String?
  verifierAgent String?
  verifiedAt    DateTime    @default(now())
  certificate   Certificate @relation(fields: [certificateId], references: [id])
}

model Admission {
  id             String          @id @default(cuid())
  applicantName  String
  fatherName     String
  motherName     String
  dateOfBirth    DateTime
  gender         Gender
  class          String
  session        String
  previousSchool String?
  previousClass  String?
  previousGpa    Float?
  phone          String
  address        String
  photo          String?
  status         AdmissionStatus @default(PENDING)
  notes          String?         @db.Text
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model CommitteeMember {
  id          String        @id @default(cuid())
  name        String
  banglaName  String?
  designation String
  role        CommitteeRole @default(MEMBER)
  phone       String?
  photo       String?
  tenure      String?
  isActive    Boolean       @default(true)
  orderIndex  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model Gallery {
  id          String    @id @default(cuid())
  title       String
  imageUrl    String
  category    String    @default("General")
  description String?
  takenAt     DateTime?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Facility {
  id          String   @id @default(cuid())
  name        String
  description String   @db.Text
  icon        String?
  imageUrl    String?
  isActive    Boolean  @default(true)
  orderIndex  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
